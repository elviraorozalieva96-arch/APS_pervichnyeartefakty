@startuml
skinparam backgroundColor #FEFEFE
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor black
skinparam ArrowColor black

title Вариант 9: ИБ ИЗ1 ПЗ2 Д1О32 Д1ОО5 Д2П1 Д2Б5 ОР1 ОД3\n<size:12>Служба технической поддержки корпоративных клиентов</size>

|#LightBlue|Клиент|
start
:Генерация заявки (ИЗ1);

|#LightGreen|Диспетчер приёма|
:Получение заявки;
if (Очередь полна?) then (да)
  :Отказ (Д1ОО5);
  |#LightPink|Отказ|
  :Заявка потеряна;
  stop
else (нет)
  |#LightGreen|Диспетчер приёма|
  :Постановка в конец очереди (Д1О32);
endif

|#LightYellow|Очередь|
:Заявка в очереди;
|#LightGray|Планировщик|
:Уведомление о новой заявке;

repeat
  |#PeachPuff|Инженер|
  :Освобождение инженера\n(триггер от любого прибора);
  
  |#LightGray|Планировщик|
  if (Активный пакет не пуст?) then (да)
    :Взять заявку из активного пакета (Д2Б5);
  else (нет)
    :Определить приоритетный источник\n(наименьший номер);
    :Сформировать новый пакет (Д2Б5)\nснимок, не расширяем;
    :Взять заявку из пакета (Д2Б5);
  endif
  
  :Назначить заявку инженеру\n(Д2П1: первый свободный по номеру);
  
  |#PeachPuff|Инженер|
  :Обслуживание (ПЗ2);
  
  |#LightYellow|Очередь|
  :Обновление состояния очереди;
  
  |#LightGray|Планировщик|
  if (В очереди есть заявки?) then (да)
    :Продолжить цикл;
  else (нет)
    :Очередь пуста;
    stop
  endif
repeat while (Есть заявки?) is (да) -> нет;

|#PeachPuff|Инженер|
:Инженер простаивает;
stop

@enduml
