@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE

title Диаграмма классов: Вариант 9

class Source {
  - sourceId: int
  - interArrivalLaw: Law
  + Source(int id, Law law)
  + generateRequest(): Request
  + getSourceId(): int
}

class Request {
  - requestId: int
  - sourceId: int
  - arrivalTime: double
  - startServiceTime: double
  - endServiceTime: double
  + Request(int id, int srcId, double time)
  + getRequestId(): int
  + getSourceId(): int
  + getArrivalTime(): double
  + setStartServiceTime(double): void
  + setEndServiceTime(double): void
}

class Buffer {
  - capacity: int
  - requests: List<Request>
  - currentPackage: List<Request>
  + Buffer(int cap)
  + putRequest(Request req): bool
  + isFull(): bool
  + isEmpty(): bool
  + getRequest(): Request
  + selectByPriority(): Request
  + formPackage(int sourceId): void
  + isPackageEmpty(): bool
  + getPackageRequest(): Request
}

class Device {
  - deviceId: int
  - busy: bool
  - serviceLaw: Law
  - currentRequest: Request
  + Device(int id, Law law)
  + isBusy(): boolean
  + startService(Request req): void
  + finishService(): Request
  + getDeviceId(): int
}

class DispatcherPost {
  - buffer: Buffer
  - rejectCount: int
  + DispatcherPost(Buffer b)
  + receiveRequest(Request req): bool
  + getRejectCount(): int
}

class DispatcherSelect {
  - buffer: Buffer
  - devices: List<Device>
  - selectLaw: int
  - deviceLaw: int
  + DispatcherSelect(Buffer b, List<Device> d)
  + onDeviceFree(Device dev): void
  + selectRequest(): Request
  + assignToDevice(Request req, Device dev): void
}

class Statistics {
  - generated: Map<int, int>
  - rejected: Map<int, int>
  - totalWaitTime: Map<int, double>
  - totalServiceTime: Map<int, double>
  + recordGenerated(int sourceId): void
  + recordRejected(int sourceId): void
  + recordWait(int sourceId, double time): void
  + recordService(int sourceId, double time): void
  + getSummaryTable(): Table
}

class System {
  - sources: List<Source>
  - buffer: Buffer
  - devices: List<Device>
  - dispatcherPost: DispatcherPost
  - dispatcherSelect: DispatcherSelect
  - statistics: Statistics
  - currentTime: double
  + System(config: Config)
  + start(): void
  + step(): void
  + getStatistics(): Statistics
}

Source "1" --> "*" Request : генерирует
Request "*" --> "1" Buffer : хранится
DispatcherPost "1" --> "1" Buffer : ссылка
DispatcherSelect "1" --> "1" Buffer : ссылка
DispatcherSelect "1" --> "*" Device : ссылка
DispatcherSelect "1" --> "1" Statistics : ссылка
System "1" *-- "1" DispatcherPost
System "1" *-- "1" DispatcherSelect
System "1" *-- "1" Buffer
System "1" *-- "*" Device
System "1" *-- "*" Source
System "1" *-- "1" Statistics

note right of DispatcherPost
  Д1О32: putRequest() ставит
  заявку в конец очереди.
  Д1ОО5: если буфер полон,
  возвращает false (отказ).
end note

note right of DispatcherSelect
  Д2Б5: selectRequest() выбирает
  заявку с учётом пакетной обработки.
  Д2П1: assignToDevice() выбирает
  первый свободный прибор по номеру.
end note

note right of Buffer
  Д1О32: при извлечении заявки
  остальные сдвигаются.
  Д2Б5: formPackage() формирует
  пакет из заявок одного источника.
end note

@enduml
